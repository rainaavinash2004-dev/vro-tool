# ─── VRO Tool – Supabase Environment Variables ───────────────────────────────
# Copy this file to .env.local and fill in your values before running locally.
# These same vars must be added to your Vercel project settings.

# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY_HERE
